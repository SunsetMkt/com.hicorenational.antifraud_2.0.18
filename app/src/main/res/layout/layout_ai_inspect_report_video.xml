<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mVideoReport"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dp_14"
    android:layout_marginEnd="@dimen/dp_14">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_radius_white_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_15"
        android:paddingEnd="@dimen/dp_15">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="视频格式"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black_dark"
                android:id="@+id/mVideoFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="视频大小"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black_dark"
                android:id="@+id/mVideoSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="视频时长"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black_dark"
                android:id="@+id/mVideoDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分辨率"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/black_dark"
                android:id="@+id/mVideoResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/black_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:text="@string/ai_inspection_report_video_tip"/>
</LinearLayout>
